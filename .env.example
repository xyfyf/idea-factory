# 复制本文件为 .env.local 后填写（.env.local 不要提交到 Git）
# 服务器部署：复制为 .env.production，变量名相同（Next 生产环境会读取）

# 推荐：DeepSeek（与 OpenAI SDK 兼容），用于「需求澄清」对话
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# 或使用官方 OpenAI（与上面二选一即可，代码优先读取 DEEPSEEK_API_KEY）
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
